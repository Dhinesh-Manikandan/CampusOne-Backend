pipeline {

    agent any

    options {
        skipDefaultCheckout(true)
    }

    environment {
        DOCKER_EXE = 'C:\\Users\\Dell\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe'

        DOCKER_HUB_USER = 'dhineshmanikandan2006'
        DOCKER_IMAGE_NAME = 'dhineshmanikandan2006/campusone-backend'

        DOCKER_PAT_CREDENTIALS_ID = 'docker-hub-pat'

        PROJECT_DIR = 'campusone/campusone'

        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                echo '=============================================='
                echo 'Stage 1: Checkout Source Code'
                echo '=============================================='

                checkout scm

                bat '''
                    echo ===== BACKEND PROJECT =====
                    dir campusone\\campusone
                '''

                script {
                    if (!fileExists('campusone/campusone/pom.xml')) {
                        error 'ERROR: pom.xml not found in campusone/campusone'
                    }

                    echo 'Maven project found at: campusone/campusone'
                }
            }
        }

        stage('Maven Clean') {
            steps {
                echo '=============================================='
                echo 'Stage 2: Maven Clean'
                echo '=============================================='

                dir("${env.PROJECT_DIR}") {
                    bat 'mvn clean'
                }
            }
        }

        stage('Run Tests') {
            steps {
                echo '=============================================='
                echo 'Stage 3: Run Tests'
                echo '=============================================='

                dir("${env.PROJECT_DIR}") {
                    bat 'mvn test'
                }
            }
        }

        stage('Maven Package') {
            steps {
                echo '=============================================='
                echo 'Stage 4: Maven Package'
                echo '=============================================='

                dir("${env.PROJECT_DIR}") {
                    bat 'mvn package -DskipTests'
                }
            }
        }

        stage('Verify Docker') {
            steps {
                echo '=============================================='
                echo 'Stage 5: Verify Docker'
                echo '=============================================='

                bat '"%DOCKER_EXE%" --version'
            }
        }

        stage('Docker Build') {
            steps {
                echo '=============================================='
                echo 'Stage 6: Docker Build'
                echo '=============================================='

                dir("${env.PROJECT_DIR}") {
                    bat """
                        "%DOCKER_EXE%" build ^
                        -t %DOCKER_IMAGE_NAME%:%IMAGE_TAG% ^
                        -t %DOCKER_IMAGE_NAME%:latest .
                    """
                }
            }
        }

        stage('Docker Hub Login') {
            steps {
                echo '=============================================='
                echo 'Stage 7: Docker Hub Login'
                echo '=============================================='

                withCredentials([
                    string(
                        credentialsId: "${DOCKER_PAT_CREDENTIALS_ID}",
                        variable: 'DOCKER_PAT'
                    )
                ]) {

                    powershell '''
                        $DOCKER_PAT | & $env:DOCKER_EXE login `
                            --username $env:DOCKER_HUB_USER `
                            --password-stdin

                        if ($LASTEXITCODE -ne 0) {
                            exit $LASTEXITCODE
                        }
                    '''
                }
            }
        }

        stage('Docker Push') {
            steps {
                echo '=============================================='
                echo 'Stage 8: Docker Push'
                echo '=============================================='

                bat """
                    "%DOCKER_EXE%" push %DOCKER_IMAGE_NAME%:%IMAGE_TAG%
                    "%DOCKER_EXE%" push %DOCKER_IMAGE_NAME%:latest
                """
            }
        }

        stage('Verify Docker Image') {
            steps {
                echo '=============================================='
                echo 'Stage 9: Verify Docker Image'
                echo '=============================================='

                bat """
                    "%DOCKER_EXE%" images %DOCKER_IMAGE_NAME%
                """
            }
        }
    }

    post {

        always {
            echo 'Jenkins pipeline execution completed.'

            bat '''
                "%DOCKER_EXE%" logout || exit 0
            '''
        }

        success {
            echo '''
            ==============================================
            CAMPUSONE BACKEND PIPELINE SUCCESS
            ==============================================
            Docker image successfully built and pushed.
            ==============================================
            '''
        }

        failure {
            echo '''
            ==============================================
            CAMPUSONE BACKEND PIPELINE FAILED
            ==============================================
            Please check the Jenkins console output
            for the failed stage.
            ==============================================
            '''
        }
    }
}
